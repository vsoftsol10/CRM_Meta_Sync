PORT=3000
PUBLIC_BASE_URL=https://crm-meta-sync.onrender.com
CRM_API_URL=https://vconstech-crm-new.onrender.com/api/leads

# Any random string you choose — Meta echoes this back during webhook verification
META_VERIFY_TOKEN=choose_any_random_string

# From Meta App Dashboard > Messenger/Instagram > Page access token
PAGE_ACCESS_TOKEN=

# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
